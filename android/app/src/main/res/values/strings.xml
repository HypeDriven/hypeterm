    <string name="pair_with_code">Pair this device</string>
    <string name="pairing_in_progress">Pairing…</string>
    <string name="pairing_code_required">Paste the pairing code first</string>

    <!-- Embedded Tailscale node. It carries only this app's traffic: it is not a VPN
         and does not route anything else on the device. -->
    <string name="tunnel_section">Reach the relay over Tailscale</string>
    <string name="tunnel_explanation">Hypeterm can join your tailnet by itself, so a relay
        that is not exposed to the internet is still reachable. Only this app\'s traffic goes
        through it — it is not a device-wide VPN, and no diagnostics are uploaded.</string>
    <string name="tunnel_enable">Use Tailscale</string>
    <string name="tunnel_auth_key_hint">Auth key (optional — leave empty to sign in with a browser)</string>
