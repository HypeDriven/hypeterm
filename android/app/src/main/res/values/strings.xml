    <!-- Pairing. There are no usernames or passwords: an identity is a public key. -->
    <string name="pairing_explanation">On the machine you want to reach, run
        <b>hypeterm-publish pair-code</b> and paste what it prints below. That is the whole of
        it: this device makes its own key and keeps the private half, and the code carries
        the relay address, so there is nothing else to fill in. The code is valid for a few
        minutes.</string>
    <string name="pairing_relay_heading">Relay</string>
    <string name="pairing_relay_unset">Not paired yet</string>
