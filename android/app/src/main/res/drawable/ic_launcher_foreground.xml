<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a shell prompt — chevron and cursor.
     The mark spans roughly 56 x 52 units inside the 66-unit safe zone (x and y between
     21 and 87), so it fills the keyline without any launcher mask clipping it. Strokes
     are round-capped, which keeps the weight even when a launcher scales it down. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M31,33 L53,54 L31,75"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31" android:startY="33"
                android:endX="53" android:endY="75">
                <item android:offset="0.0" android:color="#FF8CF4B4" />
                <item android:offset="1.0" android:color="#FF39C4F5" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M63,70 L77,70"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeColor="#FFEDF5FB" />
</vector>
