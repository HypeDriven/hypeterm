<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred to another device.

     The credential is a Keystore-sealed device key: it is bound to this device's
     hardware and would be useless elsewhere, and the resume cursors and cached
     terminal metadata describe someone's sessions (spec §12). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
